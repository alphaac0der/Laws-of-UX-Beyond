---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LawDiagram from '../components/LawDiagram.astro';

const picks = (await getCollection('laws'))
  .filter((l) => ['hicks-law', 'fitts-law', 'jakobs-law'].includes(l.id))
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title="Page not found · Laws of UX Beyond">
  <section class="wrap notfound">
    <p class="notfound-code">404</p>
    <h1>This page doesn’t exist.</h1>
    <p class="notfound-text">
      The link may be old or mistyped. By Jakob’s Law, you probably expected a home button, so here it is.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/">Go to the homepage</a>
      <a class="btn" href="/#laws">Browse all laws</a>
    </div>
    <div class="related" style="margin-top:48px;max-width:720px">
      {
        picks.map((l) => (
          <a href={`/laws/${l.id}`}>
            <LawDiagram slug={l.id} />
            <span>
              <small>{l.data.category}</small>
              <strong>{l.data.title}</strong>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .notfound { padding-block: 96px 24px; }
  .notfound-code { font-size: 14px; font-weight: 600; color: var(--accent-text); margin: 0 0 12px; font-variant-numeric: tabular-nums; }
  .notfound h1 { font-size: clamp(36px, 6vw, 64px); font-weight: 650; letter-spacing: -0.04em; }
  .notfound-text { font-size: 18px; color: var(--text-2); max-width: 520px; margin: 20px 0 28px; }
</style>
